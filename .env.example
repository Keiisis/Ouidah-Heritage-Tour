# Modèle sans secret. Copier en .env.local pour le poste opérateur.
# Vercel : uniquement les sections « Vercel », valeurs propres à chaque environnement.
# Secrets au type Secret, autres réglages au type Config. Aucune variable NEXT_PUBLIC_.
# Après changement Vercel : redéployer. Guide hors dépôt : reprises/BRANCHEMENTS-PRODUCTION.md.

# Vercel — socle serveur. SITE_URL = origine HTTPS canonique, sans chemin.
SITE_URL=
SUPABASE_URL=
# Clé serveur Supabase sb_secret_... ou ancienne service_role, jamais anon/publishable.
SUPABASE_SECRET_KEY=
# Trois secrets indépendants et stables : au moins 32 octets aléatoires chacun.
EQUIPE_SEL=
EMPREINTE_SEL=
BILLET_SECRET=
# Secret indépendant pour les tâches planifiées ; au moins 32 caractères aléatoires.
CRON_SECRET=

# Vercel — courrier sortant et destinataire des avis internes.
EMAIL_OHT=
SMTP_HOTE=
# 465 (TLS implicite) ou 587 (STARTTLS obligatoire).
SMTP_PORT=465
SMTP_UTILISATEUR=
SMTP_MDP=

# Vercel — Groq : une ou plusieurs clés séparées par une virgule.
# Modèles, budgets et activations se règlent dans l'admin.
GROQ_API_KEYS=

# Vercel — réception IMAP, si activée dans l'admin. TLS obligatoire.
IMAP_HOTE=
IMAP_PORT=993
IMAP_UTILISATEUR=
IMAP_MDP=
IMAP_DOSSIER=INBOX

# Vercel — renseigner les seules passerelles retenues, puis les activer dans l'admin.
# Recette : clés de test + true ; production : clés live + false. Jamais de mélange.
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_WEBHOOK_SECRET=
KKIAPAY_SANDBOX=false
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_SANDBOX=false
# Stripe : clé live et secret de destination webhook Snapshot correspondant.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Vercel — e-MECeF : jeton DGI propre à l'environnement, jamais exposé au navigateur.
# Workflow explicite dans /admins/emcf ; aucune émission fiscale automatique.
EMCF_JETON=
# test par défaut. production uniquement après validation du SFE par la DGI.
EMCF_ENVIRONNEMENT=test
# 1 autorise le connecteur de production après validation DGI ; 0 le verrouille.
# L'ancien interrupteur emcf_actif reste verrouillé. Voir reprises/REPRISE-emcf.md.
EMCF_PRODUCTION_AUTORISEE=0

# Poste local uniquement — ne jamais ajouter ces quatre variables dans Vercel.
BOUTIQUE_BROUILLONS=
EQUIPE_DEMO=
# Fichiers .jsonl absolus HORS du dépôt pour la simulation locale.
EQUIPE_BOITE=
ASSISTANT_FAUX=

# Opérateur uniquement — sauvegarde PostgreSQL HORS Vercel. Pas d'activation implicite.
# Charger explicitement .env.local via node --env-file, ou fournir les variables au processus.
OHT_SAUVEGARDE_ACTIVE=0
OHT_SAUVEGARDE_ENVOI=0
# Clé AES distincte : 32 octets aléatoires, encodés en 64 caractères hexadécimaux.
# Garder une copie sécurisée indépendante : perdre la clé empêche la restauration.
OHT_SAUVEGARDE_CLE=
# Dossier local absolu hors dépôt ; aucun nettoyage automatique des archives.
OHT_SAUVEGARDE_DOSSIER=
# Chemin de pg_dump si absent du PATH, version au moins égale à celle du serveur.
OHT_PG_DUMP=
# Connexion directe ou session pooler Supabase ; pas de transaction pooler ni d'URI.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=
# Destination : bucket privé oht-sauvegardes du projet configuré ci-dessus.
# Même projet : ne couvre pas sa disparition. Fichiers binaires Storage exclus.
